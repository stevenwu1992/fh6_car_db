# 复制为 .env 后按需修改；变量也会被 shell 环境覆盖
PORT=8787
DB_PATH=./server/data/fh6.db
SITE_ORIGIN=http://localhost:8787
API_ORIGIN=
ADMIN_EMAILS=
# 后台管理密码：留空则 /auth/admin/login 直接返回 503（后台无法登录）
# 生成一个够强的：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=
# 后台会话有效期（小时，1–72），默认 12
ADMIN_TTL_HOURS=12
DEV=1
NODE_ENV=development
